{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "DevToolkit",
  "version": "0.1.2",
  "identifier": "com.devtoolkit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:fe",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:fe",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevToolkit",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cottonstartiet/DevToolkit/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMUQ2RERDREYyRUYxNDkKUldSSjhTN2YzRzBkSGE2UG9Bam5Nb3VVelowQTk1OW9icnhBRTQ3bHBOUkpTS0hVUWxaTktRd2kK"
    }
  }
}
